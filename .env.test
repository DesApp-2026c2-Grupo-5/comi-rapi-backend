SQL_USERNAME=unahur_desapp
SQL_PASSWORD=desarrollo
SQL_DATABASE=unahur_desapp_dev

SQL_TEST_DATABASE=unahur_desapp_test

SESSION_SECRET=comi-rapi-secret-test-no-usar-en-produccion
SESSION_TTL_MIN=60
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_ENABLED=false

CORS_ORIGIN=http://localhost:5173

# Recuperación de contraseña
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=10
PASSWORD_RESET_RATE_LIMIT_IP_MAX=3
PASSWORD_RESET_RATE_LIMIT_IP_WINDOW_MINUTES=60
PASSWORD_RESET_RATE_LIMIT_EMAIL_MAX=3
PASSWORD_RESET_RATE_LIMIT_EMAIL_WINDOW_MINUTES=60

# En los tests no se envía ningún email real.
MAIL_TRANSPORT=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@comiapi.local

# Las fotos de perfil de los tests van a una carpeta temporal del backend,
# nunca al public del frontend.
IMAGENES_PERFILES_DIR=./test/tmp/perfiles