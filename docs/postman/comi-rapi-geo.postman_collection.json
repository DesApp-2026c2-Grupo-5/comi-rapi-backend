                  "pm.test('200 sesión admin (resultado esperado)', () => {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST sucursal dentro de la zona → 201 (guarda {{sucursalId}})",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Sucursal Prueba Tarea 7\",\n  \"direccion\": {\n    \"calle\": \"Av. de Mayo\",\n    \"altura\": 700,\n    \"provincia\": \"Ciudad Autónoma de Buenos Aires\",\n    \"localidad\": \"CABA\"\n  }\n}" },
            "url": "{{baseUrl}}/sucursales"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 geocodificada (resultado esperado)', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d.direccion.latitud).to.be.a('number');",
                  "  pm.expect(d.direccion.nomenclatura).to.be.a('string').and.not.empty;",
                  "  pm.environment.set('sucursalId', String(d.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST sucursal FUERA de la zona → 201 (admin sin cobertura comercial)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Sucursal Fuera Zona T7\",\n  \"direccion\": {\n    \"calle\": \"Alsina\",\n    \"altura\": 25,\n    \"provincia\": \"Buenos Aires\",\n    \"departamento\": \"Bahía Blanca\"\n  }\n}" },
            "url": "{{baseUrl}}/sucursales"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 aunque la zona NO está habilitada para clientes (resultado esperado: regla conservada)', () => {",
                  "  pm.response.to.have.status(201);",
