                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Re-login cliente + DELETE baja lógica → 200",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('re-login cliente (prerrequisito del DELETE)', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "// El DELETE se hace en el request siguiente."
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE {{direccionId}}",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "x-csrf-token", "value": "{{csrfToken}}" }],
