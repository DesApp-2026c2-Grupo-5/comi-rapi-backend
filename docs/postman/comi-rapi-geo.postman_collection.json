            "body": { "mode": "raw", "raw": "{\n  \"altura\": -5\n}" },
            "url": "{{baseUrl}}/direcciones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 con calle y altura (resultado esperado)', () => {",
                  "  pm.response.to.have.status(400);",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e).to.match(/calle/);",
                  "  pm.expect(e).to.match(/altura/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET listado del cliente",
          "request": { "method": "GET", "url": "{{baseUrl}}/direcciones" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con la dirección creada (resultado esperado)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(Array.isArray(d)).to.eql(true);",
                  "  pm.expect(d.map(x => String(x.id))).to.include(pm.environment.get('direccionId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET por id",
          "request": { "method": "GET", "url": "{{baseUrl}}/direcciones/{{direccionId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con la dirección propia (resultado esperado)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(String(pm.response.json().data.id)).to.eql(pm.environment.get('direccionId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT solo alias → 200 (sin re-geocodificar)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"alias\": \"Alias actualizado\"\n}" },
            "url": "{{baseUrl}}/direcciones/{{direccionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con alias actualizado y coords conservadas (resultado esperado)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d.alias).to.eql('Alias actualizado');",
                  "  pm.expect(d.latitud).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro otro usuario (tolerante a re-ejecución)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Otro\",\n  \"email\": \"{{otroEmail}}\",\n  \"password\": \"{{password}}\",\n  \"rol\": \"CLIENTE\"\n}" },
            "url": "{{baseUrl}}/auth/registro"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('registro OK (201) o email ya existente en re-ejecuciones (400/409)', () => {",
                  "  pm.expect([200, 201, 400, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login otro usuario (sesión para el 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{otroEmail}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 sesión como otro usuario (prerrequisito del 403)', () => {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT ajena → 403",
          "request": {
            "method": "PUT",
