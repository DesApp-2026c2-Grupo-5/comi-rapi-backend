SQL_USERNAME=unahur_desapp
SQL_PASSWORD=desarrollo
SQL_DATABASE=unahur_desapp_dev

SQL_TEST_DATABASE=unahur_desapp_test

SESSION_SECRET=comi-rapi-secret-dev-no-usar-en-produccion
SESSION_TTL_MIN=480
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_ENABLED=true

CORS_ORIGIN=http://localhost:5173

# Recuperación de contraseña
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=10

# Límites de recuperación en DESARROLLO, deliberadamente más laxos que en
# producción (3/hora).
#
# Motivo: en desarrollo todas las peticiones salen de 127.0.0.1, así que el
# límite por IP se agota con apenas unas pruebas manuales y empieza a bloquear
# sin que nadie haya hecho nada sospechoso. Con 3/hora es imposible iterar.
#
# El valor de producción sigue siendo 3; ver .env.example.
PASSWORD_RESET_RATE_LIMIT_IP_MAX=20
PASSWORD_RESET_RATE_LIMIT_IP_WINDOW_MINUTES=60
PASSWORD_RESET_RATE_LIMIT_EMAIL_MAX=10
PASSWORD_RESET_RATE_LIMIT_EMAIL_WINDOW_MINUTES=60

# Envío de emails. En desarrollo apunta a Mailpit.
# El backend corre directo en Windows: usar localhost.
# Dentro de Docker: usar mailpit.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@comiapi.local