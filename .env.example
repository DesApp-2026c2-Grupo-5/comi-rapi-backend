SQL_USERNAME=unahur_desapp
SQL_PASSWORD=desarrollo
SQL_DATABASE=unahur_desapp_dev

SQL_TEST_DATABASE=unahur_desapp_test

# Sesiones (cambiar SESSION_SECRET por un valor largo y aleatorio)
SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
SESSION_TTL_MIN=480
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_ENABLED=true

# Origen permitido de CORS (frontend). En producción: el dominio del frontend.
CORS_ORIGIN=http://localhost:5173

# Georef Argentina (geocodificación de direcciones). API pública, sin secretos.
GEOREF_BASE_URL=https://apis.datos.gob.ar/georef
GEOREF_TIMEOUT_MS=5000
GEOREF_MAX_RESULTADOS=10

# OpenRouteService (cálculo de rutas: distancia/duración).
# Clave gratuita desde https://openrouteservice.org/dev/#/signup
# NUNCA commitear la clave real: ponerla en .env.local (gitignored), que gana sobre este archivo.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_TIMEOUT_MS=5000
ORS_PROFILE=driving-car

# URL pública del frontend. Se usa para armar el enlace del email de recuperación.
FRONTEND_URL=http://localhost:5173

# Recuperación de contraseña: vigencia del token (minutos) y límites de solicitudes.
# Estos valores son los de PRODUCCIÓN y no deberían relajarse en un entorno real.
#
# En el .env.development conviene subirlos: todas las peticiones de desarrollo
# salen de 127.0.0.1, así que con 3 por hora el límite se agota con unas pocas
# pruebas manuales y bloquea al que está desarrollando, no a un atacante.
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=10
PASSWORD_RESET_RATE_LIMIT_IP_MAX=3
PASSWORD_RESET_RATE_LIMIT_IP_WINDOW_MINUTES=60
PASSWORD_RESET_RATE_LIMIT_EMAIL_MAX=3
PASSWORD_RESET_RATE_LIMIT_EMAIL_WINDOW_MINUTES=60

# Cambio de contraseña desde el perfil: intentos por usuario (no por IP, para
# que un atacante con una sesión robada no pueda probarla indefinidamente).
PERFIL_RATE_LIMIT_PASSWORD_MAX=5
PERFIL_RATE_LIMIT_PASSWORD_WINDOW_MINUTES=15

# Envío de emails.
# MAIL_TRANSPORT: 'smtp' para envío real. En desarrollo se usa Mailpit.
#   Backend directo en Windows -> SMTP_HOST=localhost
#   Backend dentro de Docker    -> SMTP_HOST=mailpit
# Mailpit es SOLO para desarrollo; en producción se cambia a un proveedor real
# (SendGrid, SES, Brevo, Mailgun o SMTP propio) sin tocar la lógica de recuperación.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@comiapi.local

# Imágenes. Por defecto se escriben en el repo del frontend (public/imagenes/<carpeta>)
# y se sirven desde la raíz de Vite en desarrollo. En producción, apuntar a un
# almacenamiento persistente (S3, bucket propio, etc.).
# IMAGENES_DIR=../comi-rapi-fronted/public/imagenes/productos
# IMAGENES_CATEGORIAS_DIR=../comi-rapi-fronted/public/imagenes/categorias
# IMAGENES_PERFILES_DIR=../comi-rapi-fronted/public/imagenes/perfiles