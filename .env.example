SQL_USERNAME=unahur_desapp
SQL_PASSWORD=desarrollo
SQL_DATABASE=unahur_desapp_dev

SQL_TEST_DATABASE=unahur_desapp_test

# Sesiones (cambiar SESSION_SECRET por un valor largo y aleatorio)
SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
SESSION_TTL_MIN=480
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_ENABLED=true

# Origen permitido de CORS (frontend). En producción: el dominio del frontend.
CORS_ORIGIN=http://localhost:5173

# Georef Argentina (geocodificación de direcciones). API pública, sin secretos.
GEOREF_BASE_URL=https://apis.datos.gob.ar/georef
GEOREF_TIMEOUT_MS=5000
GEOREF_MAX_RESULTADOS=10

# OpenRouteService (cálculo de rutas: distancia/duración).
# Clave gratuita desde https://openrouteservice.org/dev/#/signup
# NUNCA commitear la clave real: ponerla en .env.local (gitignored), que gana sobre este archivo.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_TIMEOUT_MS=5000
ORS_PROFILE=driving-car

# Cobertura geográfica (radio máximo de delivery en km). Zonas en cobertura-zonas.js.
COBERTURA_RADIO_MAX_KM=5