SQL_USERNAME=unahur_desapp
SQL_PASSWORD=desarrollo
SQL_DATABASE=unahur_desapp_dev

SQL_TEST_DATABASE=unahur_desapp_test

# Sesiones (cambiar SESSION_SECRET por un valor largo y aleatorio)
SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
SESSION_TTL_MIN=480
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_ENABLED=true

# Origen permitido de CORS (frontend). En producción: el dominio del frontend.
CORS_ORIGIN=http://localhost:5173

# URL pública del frontend. Se usa para armar el enlace del email de recuperación.
FRONTEND_URL=http://localhost:5173

# Recuperación de contraseña: vigencia del token (minutos) y límites de solicitudes.
# Estos valores son los de PRODUCCIÓN y no deberían relajarse en un entorno real.
#
# En el .env.development conviene subirlos: todas las peticiones de desarrollo
# salen de 127.0.0.1, así que con 3 por hora el límite se agota con unas pocas
# pruebas manuales y bloquea al que está desarrollando, no a un atacante.
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=10
PASSWORD_RESET_RATE_LIMIT_IP_MAX=3
PASSWORD_RESET_RATE_LIMIT_IP_WINDOW_MINUTES=60
PASSWORD_RESET_RATE_LIMIT_EMAIL_MAX=3
PASSWORD_RESET_RATE_LIMIT_EMAIL_WINDOW_MINUTES=60

# Envío de emails.
# MAIL_TRANSPORT: 'smtp' para envío real. En desarrollo se usa Mailpit.
#   Backend directo en Windows -> SMTP_HOST=localhost
#   Backend dentro de Docker    -> SMTP_HOST=mailpit
# Mailpit es SOLO para desarrollo; en producción se cambia a un proveedor real
# (SendGrid, SES, Brevo, Mailgun o SMTP propio) sin tocar la lógica de recuperación.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@comiapi.local